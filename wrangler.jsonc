// DailyDairy super admin console: static site served by Cloudflare Workers (static assets, no server code).
// Deploy: npm run deploy  (needs `npx wrangler login` once)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailydairy-super-admin",
  "compatibility_date": "2025-09-15",
  "workers_dev": true,
  // Add a custom domain once you have one, e.g. [{ "pattern": "admin.yourdomain.in", "custom_domain": true }]
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths serve index.html so links like /dairies/:id work.
    "not_found_handling": "single-page-application"
  }
}
